# Dependencies (Docker will run 'npm install' fresh inside the container)
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Next.js build cache (Docker will generate this fresh)
.next
out

# Git files
.git
.gitignore

# Docker files (no need to copy these into the image)
Dockerfile
.dockerignore

# Local environment variables (never copy secrets into the image)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
Thumbs.db